{
	"name": "monaco-wiki",
	"version": "2.1.0",
	"description": "Monaco editor for MediaWiki sites",
	"keywords": [
		"monaco",
		"mediawiki",
		"wikitext"
	],
	"homepage": "https://github.com/bhsd-harry/monaco-wiki#readme",
	"bugs": {
		"url": "https://github.com/bhsd-harry/monaco-wiki/issues"
	},
	"license": "GPL-3.0-or-later",
	"author": "Bhsd",
	"type": "module",
	"files": [
		"/dist/",
		"!/dist/*.map"
	],
	"sideEffects": false,
	"browser": "dist/main.min.js",
	"main": "./dist/main.js",
	"types": "./dist/main.d.ts",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/bhsd-harry/monaco-wiki.git"
	},
	"scripts": {
		"ls": "npm i --package-lock-only && npm ls --package-lock-only --all --omit=dev",
		"prepublishOnly": "npm run build",
		"lint:ts": "tsc --noEmit && tsc --project gh-page/tsconfig.json --noEmit && tsc --project test/tsconfig.json --noEmit && tsc --project bundle/tsconfig.json && eslint --cache .",
		"lint:css": "stylelint --cache gh-page/*.css",
		"lint:md": "markdownlint-cli2 '**/*.md'",
		"lint": "npm run lint:ts && npm run lint:css && npm run lint:md",
		"build:core": "tsc && rm dist/all.d.ts",
		"build:gh-page": "tsc --project gh-page/tsconfig.json",
		"build:test": "rm -rf test/dist/; tsc --project test/tsconfig.json && npm test",
		"build": "rm -rf dist/; npm run build:core && node build.js && gsed -i '/^\\/\\/ /d' dist/main.js && eslint --no-config-lookup -c eslint.dist.mjs dist/*.min.js",
		"server": "npm run test:end; http-server .. -c-1 --cors -s &",
		"test": "mocha",
		"test:regex": "node test/dist/test/optimizer.js",
		"test:real": "node test/dist/test/real.js",
		"test:end": "pkill -x http-server"
	},
	"peerDependencies": {
		"@shikijs/monaco": ">=1.25.0",
		"monaco-editor": ">=0.34.0",
		"shiki": ">=1.25.0",
		"wikiparser-node": ">=1.39.0"
	},
	"peerDependenciesMeta": {
		"monaco-editor": {
			"optional": true
		},
		"wikiparser-node": {
			"optional": true
		}
	},
	"dependencies": {
		"@bhsd/browser": "^0.5.0",
		"@bhsd/cm-util": "^2.2.0",
		"@bhsd/codemirror-mediawiki": "^3.20.0"
	},
	"devDependencies": {
		"@bhsd/code-standard": "^2.6.2",
		"@bhsd/test-util": "^1.5.0",
		"@shikijs/monaco": "^4.0.2",
		"esbuild": "^0.28.0",
		"eslint": "^10.4.1",
		"http-server": "^14.1.1",
		"markdownlint-cli2": "^0.22.1",
		"mocha": "^11.7.6",
		"monaco-editor": "~0.53.0",
		"oniguruma-parser": "^0.12.2",
		"shiki": "^4.0.2",
		"stylelint": "^17.13.0",
		"typescript": "^6.0.3",
		"types-mediawiki": "^2.0.0",
		"wikiparser-node": "^1.44.0"
	}
}
